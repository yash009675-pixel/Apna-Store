{
  "name": "Apna Store",
  "short_name": "Apna Store",
  "description": "Shop fashion and everyday products with Apna Store.",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#f8f7f4",
